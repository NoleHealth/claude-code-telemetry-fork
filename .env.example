# Claude Code Telemetry Bridge Configuration Example
# Copy this file to .env and fill in your actual values

# Langfuse Configuration
LANGFUSE_HOST=http://localhost:3020
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# OTLP Receiver Configuration
OTLP_RECEIVER_HOST=0.0.0.0
OTLP_RECEIVER_PORT=4318

# Application Configuration
LOG_LEVEL=info
NODE_ENV=production
SESSION_TIMEOUT=3600000
MAX_REQUEST_SIZE=10485760

# Optional API Key for secured access
API_KEY=

# Docker Compose Network
COMPOSE_PROJECT_NAME=claude-code-telemetry